{
  "name": "squadhq-relay",
  "version": "1.0.0",
  "private": true,
  "description": "Local WebSocket relay between the SquadHQ dashboard (phone) and the racing game (browser).",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "tsx src/index.ts",
    "dev": "tsx watch src/index.ts",
    "test": "tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "sim:dashboard": "tsx src/tools/sim-dashboard.ts",
    "sim:game": "tsx src/tools/sim-game.ts",
    "send": "tsx src/tools/send.ts"
  },
  "dependencies": {
    "ws": "^8.22.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/ws": "^8.18.2",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3"
  }
}
