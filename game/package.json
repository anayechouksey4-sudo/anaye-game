{
  "name": "squadhq-racer",
  "private": true,
  "version": "1.0.0",
  "description": "Voxel parkour racer (React Three Fiber + Rapier) whose car physics are tuned live over WebSocket by the SquadHQ dashboard.",
  "type": "module",
  "scripts": {
    "dev": "vite --port 5173",
    "build": "tsc -b && vite build",
    "preview": "vite preview --port 4173",
    "typecheck": "tsc -b --noEmit"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "0.19.2",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@react-three/rapier": "^2.2.0",
    "react": "~19.3.1",
    "react-dom": "~19.3.1",
    "three": "^0.187.0",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "~19.3.0",
    "@types/react-dom": "~19.3.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.2.1",
    "typescript": "~5.9.3",
    "vite": "^8.3.6"
  }
}
